/* ============================================================================
   STYX TUI - AMD Minimal Theme
   Black/White base with red accents, Apple-style minimal design
   ============================================================================ */

/* Screen layout */
Screen {
    layout: vertical;
    background: black;
}

/* Header Bar */
HeaderBar {
    dock: top;
    height: 3;
    background: black;
    border: solid #444444;
    padding: 0 2;
}

#title {
    width: 1fr;
    content-align: left middle;
    text-style: bold;
    color: white;
}

#btn-power {
    width: auto;
    background: black;
    color: red;
    text-style: bold;
    content-align: center middle;
}

#btn-power:hover {
    color: white;
}

#btn-power.powered-on {
    color: green;
}

#btn-power.powered-on:hover {
    color: white;
}

/* Control Bar */
ControlBar {
    height: 3;
    background: black;
    border: solid #444444;
}

ControlBar Horizontal {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 0 2;
}

ControlButton {
    width: auto;
    height: auto;
    background: black;
    color: white;
    text-style: bold;
    padding: 0 2;
}

ControlButton:hover {
    color: red;
}

/* Main 3-Panel Layout */
#main-panels {
    height: 1fr;
    layout: horizontal;
}

#registers {
    width: 25%;
    height: 100%;
    background: black;
    border: solid #444444;
    padding: 1;
}

#code {
    width: 35%;
    height: 100%;
    background: black;
    border: solid #444444;
    padding: 1;
    layout: vertical;
}

#cpu-status {
    height: 40%;
    background: black;
    border-bottom: solid #444444;
    overflow-y: auto;
}

#disassembly-view {
    height: 60%;
    background: black;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#memory {
    width: 40%;
    height: 100%;
    background: black;
    border: solid #444444;
    padding: 0;
    layout: vertical;
}

#memory-header {
    height: auto;
    padding: 1;
    background: black;
}

#memory-scroll {
    height: 1fr;
    background: black;
}

#memory-content {
    height: auto;
    padding: 0 1;
    background: black;
}


/* Footer */
Footer {
    dock: bottom;
    height: 3;
    background: black;
    color: white;
    border: solid #444444;
    text-style: bold;
}

#footer-left {
    width: 20%;
}

#footer-center {
    width: 60%;
    content-align: center middle;
}

#footer-right {
    width: 20%;
    content-align: right middle;
    padding-right: 2;
    overflow: hidden;
    text-overflow: ellipsis;
}
