/* Screen layout */
Screen {
    layout: vertical;
}

/* Header Bar */
HeaderBar {
    dock: top;
    height: 3;
    background: $boost;
    border: tall green;
    padding: 0 1;
}

#title {
    width: 1fr;
    content-align: left middle;
    text-style: bold;
    color: $text;
}

#btn-power {
    width: auto;
    min-width: 12;
    background: $error;
    color: $text;
    text-style: bold;
    padding: 0 1;
    content-align: center middle;
}

#btn-power:hover {
    background: $error-darken-1;
}

#btn-power.powered-on {
    background: $success;
}

#btn-power.powered-on:hover {
    background: $success-darken-1;
}

/* Control Bar */
ControlBar {
    height: 3;
    background: $boost;
    border: tall green;
    padding: 0 1;
}

.control-row {
    height: 2;
    width: 100%;
    align: center middle;
}

.btn {
    width: auto;
    background: $primary;
    color: $text;
    text-style: bold;
    padding: 0 2;
    margin: 0 1;
    content-align: center middle;
}

.btn:hover {
    background: $primary-lighten-1;
}

/* Main 3-Panel Layout */
#main-panels {
    height: 1fr;
    layout: horizontal;
}

#registers {
    width: 25%;
    height: 100%;
    background: $boost;
    border: tall green;
    padding: 1;
}

#code {
    width: 35%;
    height: 100%;
    background: $boost;
    border: tall green;
    padding: 1;
    layout: vertical;
}

#cpu-status {
    height: 40%;
    background: $boost;
    border-bottom: tall green;
    overflow-y: auto;
}

#disassembly-view {
    height: 60%;
    background: $boost;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#memory {
    width: 40%;
    height: 100%;
    background: $boost;
    border: tall green;
    padding: 0;
    layout: vertical;
}

#memory-header {
    height: auto;
    padding: 1;
    background: $boost;
}

#memory-scroll {
    height: 1fr;
    background: $boost;
}

#memory-content {
    height: auto;
    padding: 0 1;
    background: $boost;
}


/* Footer */
Footer {
    dock: bottom;
    height: 3;
    background: $boost;
    color: $text;
    border: tall green;
    text-style: bold;
}

#footer-left {
    width: 20%;
}

#footer-center {
    width: 60%;
    content-align: center middle;
}

#footer-right {
    width: 20%;
    content-align: right middle;
    padding-right: 2;
    overflow: hidden;
    text-overflow: ellipsis;
}
